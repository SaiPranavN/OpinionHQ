# =============================================================================
# OpinionHQ — environment.
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not, so
# never put a real value in it.
#
#   cp .env.example .env.local
#
# Every value below comes from the Supabase dashboard:
#   Project Settings → API           for the URL and the two keys
#   Project Settings → Database      for the connection password
#   Account → Access Tokens          for the CLI token
# =============================================================================

# --------------------------------------------------------------- the app ----
# Both of these are compiled into the browser bundle. That is correct and by
# design: the publishable key identifies the project, and what protects the data
# is the row-level security in supabase/migrations, not the secrecy of this
# string.
NEXT_PUBLIC_SUPABASE_URL=https://vagxiakadfsfykspfqui.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older projects issue an `anon` JWT instead of a `sb_publishable_…` key. Either
# works — set whichever one your project shows and leave the other blank.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------ server only ----
# BYPASSES EVERY ROW POLICY. Needed only by scheduled jobs, the matching routine
# and billing webhooks. If a page needs this to work, the page is wrong.
# Never prefix it with NEXT_PUBLIC_ — that would ship it to every visitor.
SUPABASE_SECRET_KEY=

# Older projects call this the service_role key.
# SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------- the CLI ------
# Used by `npm run db:link`, `db:push` and `db:types`. Not read by the app.
SUPABASE_PROJECT_ID=vagxiakadfsfykspfqui
# Account → Access Tokens. Grants full control of your Supabase account.
SUPABASE_ACCESS_TOKEN=
# Project Settings → Database → Database password. Reset it there if unknown.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------- the site --
# Used to build absolute URLs for auth redirects (email confirmation, OAuth).
# Must exactly match an entry in Authentication → URL Configuration → Redirect
# URLs, or Supabase will refuse the callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------- email --
# Applied by `npm run auth:configure`. Without them Supabase uses its built-in
# sender, which allows a couple of emails an hour AND refuses template changes —
# so no verification code is ever emailed and sign-up cannot be completed.
#
# The sender address must be on a domain verified with the provider, and it
# should be a SUBDOMAIN when the root already sends mail: a domain can only
# carry one SPF record, and a second one breaks the first.
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=

# Defaults suit Resend, where the API key is the SMTP password.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_SENDER_NAME=OpinionHQ
# Supabase drops to 30/hour when custom SMTP is enabled; this raises it.
# SMTP_HOURLY_LIMIT=60
